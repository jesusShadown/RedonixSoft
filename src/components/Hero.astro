---
import { Image } from 'astro:assets';
import icono from '../assets/logos/redonix-icono.png';
import { WHATSAPP_COTIZA } from '../data/contacto';
---

<section id="inicio" class="fondo-escenario relative flex min-h-svh items-center overflow-hidden px-4 pb-16 pt-28 sm:px-6">
  <div class="pointer-events-none absolute -right-32 -top-32 h-96 w-96 rounded-full bg-marca-rojo/30 blur-3xl" aria-hidden="true"></div>
  <div class="pointer-events-none absolute -bottom-40 -left-24 h-96 w-96 rounded-full bg-marca-vino/60 blur-3xl" aria-hidden="true"></div>

  <div class="relative mx-auto flex w-full max-w-4xl flex-col items-center text-center">
    <Image
      src={icono}
      alt="Ícono de Redonix: una letra R roja con un ecualizador de audio"
      width={96}
      densities={[1, 2]}
      loading="eager"
      fetchpriority="high"
      class="mb-8 h-auto w-20 drop-shadow-[0_0_30px_rgba(227,27,35,0.6)] sm:w-24"
    />

    <h1 class="text-4xl font-extrabold uppercase leading-tight tracking-[0.18em] sm:text-6xl sm:tracking-escenario lg:text-7xl">
      Redonix
      <span class="block text-marca-rojo">Entertainment</span>
    </h1>

    <figure class="mt-8 max-w-2xl">
      <blockquote class="text-xl font-medium italic text-white/90 sm:text-2xl">
        “El cielo no es el límite, es nuestro comienzo”
      </blockquote>
      <figcaption class="mt-3 text-sm uppercase tracking-[0.25em] text-white/70">— Sofía Rojas, CEO</figcaption>
    </figure>

    <div class="mt-10 flex w-full flex-col gap-4 sm:w-auto sm:flex-row">
      <a
        href="#contacto"
        class="inline-flex min-h-12 items-center justify-center rounded-full bg-marca-rojo px-8 text-sm font-bold uppercase tracking-[0.15em] transition-colors hover:bg-white hover:text-marca-rojo"
      >
        Cotiza tu proyecto
      </a>
      <a
        href="#servicios"
        class="inline-flex min-h-12 items-center justify-center rounded-full border-2 border-white/80 px-8 text-sm font-bold uppercase tracking-[0.15em] transition-colors hover:bg-white hover:text-black"
      >
        Ver servicios
      </a>
    </div>
  </div>
</section>
