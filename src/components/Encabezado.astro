---
import { Image } from 'astro:assets';
import logo from '../assets/logos/redonix.png';
import Icono from './Icono.astro';
import { navegacion, WHATSAPP_COTIZA } from '../data/contacto';
---

<header class="fixed inset-x-0 top-0 z-40 border-b border-white/10 bg-black/80 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-4 sm:px-6">
    <a href="#inicio" class="shrink-0" aria-label="Redonix Entertainment, ir al inicio">
      <Image
        src={logo}
        alt="Logotipo de Redonix"
        width={140}
        densities={[1, 2]}
        loading="eager"
        class="h-auto w-28 sm:w-[140px]"
      />
    </a>

    <nav aria-label="Principal" class="hidden lg:block">
      <ul class="flex items-center gap-8 text-sm font-medium uppercase tracking-[0.15em]">
        {
          navegacion.map((item) => (
            <li>
              <a href={item.href} class="py-2 transition-colors hover:text-marca-rojo focus-visible:text-marca-rojo">
                {item.texto}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <a
        href={WHATSAPP_COTIZA}
        class="hidden items-center gap-2 rounded-full bg-marca-rojo px-5 py-2.5 text-sm font-bold uppercase tracking-wider transition-colors hover:bg-white hover:text-marca-rojo sm:inline-flex"
      >
        <Icono nombre="whatsapp" class="h-4 w-4" />
        Cotiza por WhatsApp
      </a>

      <button
        id="menu-boton"
        type="button"
        class="inline-flex h-11 w-11 items-center justify-center rounded-lg border border-white/20 lg:hidden"
        aria-expanded="false"
        aria-controls="menu-movil"
        aria-label="Abrir menú"
      >
        <Icono nombre="menu" class="h-6 w-6 icono-abrir" />
        <Icono nombre="cerrar" class="hidden h-6 w-6 icono-cerrar" />
      </button>
    </div>
  </div>

  <nav id="menu-movil" aria-label="Principal móvil" class="hidden border-t border-white/10 bg-black/95 lg:hidden">
    <ul class="mx-auto flex max-w-6xl flex-col px-4 py-2 sm:px-6">
      {
        navegacion.map((item) => (
          <li>
            <a href={item.href} class="block py-3.5 text-base font-medium uppercase tracking-[0.15em] hover:text-marca-rojo">
              {item.texto}
            </a>
          </li>
        ))
      }
      <li class="py-3 sm:hidden">
        <a
          href={WHATSAPP_COTIZA}
          class="flex items-center justify-center gap-2 rounded-full bg-marca-rojo px-5 py-3.5 text-sm font-bold uppercase tracking-wider"
        >
          <Icono nombre="whatsapp" class="h-5 w-5" />
          Cotiza por WhatsApp
        </a>
      </li>
    </ul>
  </nav>
</header>

<script>
  const boton = document.getElementById('menu-boton') as HTMLButtonElement;
  const menu = document.getElementById('menu-movil') as HTMLElement;
  const abrir = boton.querySelector('.icono-abrir') as SVGElement;
  const cerrar = boton.querySelector('.icono-cerrar') as SVGElement;

  const alternar = (visible: boolean) => {
    menu.classList.toggle('hidden', !visible);
    abrir.classList.toggle('hidden', visible);
    cerrar.classList.toggle('hidden', !visible);
    boton.setAttribute('aria-expanded', String(visible));
    boton.setAttribute('aria-label', visible ? 'Cerrar menú' : 'Abrir menú');
  };

  boton.addEventListener('click', () => alternar(menu.classList.contains('hidden')));
  menu.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) alternar(false);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') alternar(false);
  });
</script>
