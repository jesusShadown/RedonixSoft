---
import '../styles/global.css';
import fuente400 from '../../node_modules/@fontsource/outfit/files/outfit-latin-400-normal.woff2?url';
import fuente800 from '../../node_modules/@fontsource/outfit/files/outfit-latin-800-normal.woff2?url';

interface Props {
  titulo?: string;
  descripcion?: string;
}

const {
  titulo = 'Redonix Entertainment | Producción, diseño y estrategia para entretenimiento',
  descripcion = 'Empresa creativa de entretenimiento: gestión de eventos, diseño, video, audio y contenido para redes. De tu idea al escenario, somos tu mejor aliado creativo.',
} = Astro.props;

const base = Astro.site ?? Astro.url;
const imagenOg = new URL('/og.png', base).href;
const urlCanonica = Astro.site ? new URL('/', Astro.site).href : undefined;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#000000" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    {urlCanonica && <link rel="canonical" href={urlCanonica} />}
    <link rel="preload" href={fuente800} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={fuente400} as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_MX" />
    <meta property="og:site_name" content="Redonix Entertainment" />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:image" content={imagenOg} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Logotipo de Redonix Entertainment sobre fondo degradado de negro a rojo" />
    {urlCanonica && <meta property="og:url" content={urlCanonica} />}
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <slot />
  </body>
</html>

